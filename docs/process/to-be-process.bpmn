<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_SupportFlowToBe" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.53.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <bpmn:collaboration id="Collaboration_SupportFlow">
    <bpmn:participant id="Participant_Customer" name="Customer" processRef="Process_Customer" />
    <bpmn:participant id="Participant_Nordcard" name="Nordcard" processRef="Process_Nordcard" />
    <bpmn:messageFlow id="Msg_request" sourceRef="Cust_Submit" targetRef="Start_RequestReceived" />
    <bpmn:messageFlow id="Msg_duplicate" sourceRef="Task_NotifyDuplicate" targetRef="Cust_RecvDup" />
    <bpmn:messageFlow id="Msg_clarification" sourceRef="Task_RequestInfo" targetRef="Cust_RecvClarif" />
    <bpmn:messageFlow id="Msg_details" sourceRef="Cust_Provide" targetRef="Task_WaitInfo" />
    <bpmn:messageFlow id="Msg_timeout" sourceRef="Task_SendTimeout" targetRef="Cust_RecvTimeout" />
    <bpmn:messageFlow id="Msg_handoff" sourceRef="Task_SendHandoff" targetRef="Cust_RecvHandoff" />
    <bpmn:messageFlow id="Msg_autoResponse" sourceRef="Task_SendAuto" targetRef="Cust_RecvFinal" />
    <bpmn:messageFlow id="Msg_humanResponse" sourceRef="Task_SendHuman" targetRef="Cust_RecvFinal" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Customer" isExecutable="true">
    <bpmn:startEvent id="Cust_Start" name="Support needed">
      <bpmn:outgoing>Cf_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="Cust_Submit" name="Submit support request">
      <bpmn:incoming>Cf_1</bpmn:incoming>
      <bpmn:outgoing>Cf_2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:eventBasedGateway id="Cust_Wait" name="Wait for support messages">
      <bpmn:incoming>Cf_2</bpmn:incoming>
      <bpmn:incoming>Cf_11</bpmn:incoming>
      <bpmn:outgoing>Cf_3</bpmn:outgoing>
      <bpmn:outgoing>Cf_4</bpmn:outgoing>
      <bpmn:outgoing>Cf_5</bpmn:outgoing>
      <bpmn:outgoing>Cf_6</bpmn:outgoing>
      <bpmn:outgoing>Cf_7</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:receiveTask id="Cust_RecvFinal" name="Receive final response">
      <bpmn:incoming>Cf_3</bpmn:incoming>
      <bpmn:outgoing>Cf_8</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:endEvent id="Cust_EndResolved" name="Request resolved">
      <bpmn:incoming>Cf_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:receiveTask id="Cust_RecvTimeout" name="Receive timeout notice">
      <bpmn:incoming>Cf_4</bpmn:incoming>
      <bpmn:outgoing>Cf_9</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:endEvent id="Cust_EndTimeout" name="Request timed out">
      <bpmn:incoming>Cf_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:receiveTask id="Cust_RecvClarif" name="Receive clarification request">
      <bpmn:incoming>Cf_5</bpmn:incoming>
      <bpmn:outgoing>Cf_10</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:sendTask id="Cust_Provide" name="Provide additional information">
      <bpmn:incoming>Cf_10</bpmn:incoming>
      <bpmn:outgoing>Cf_11</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Cust_RecvDup" name="Receive duplicate notice">
      <bpmn:incoming>Cf_6</bpmn:incoming>
      <bpmn:outgoing>Cf_12</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:endEvent id="Cust_EndDup" name="Duplicate acknowledged">
      <bpmn:incoming>Cf_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:receiveTask id="Cust_RecvHandoff" name="Receive specialist handoff notice">
      <bpmn:incoming>Cf_7</bpmn:incoming>
      <bpmn:outgoing>Cf_13</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:endEvent id="Cust_EndHandoff" name="Case handed off">
      <bpmn:incoming>Cf_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Cf_1" sourceRef="Cust_Start" targetRef="Cust_Submit" />
    <bpmn:sequenceFlow id="Cf_2" sourceRef="Cust_Submit" targetRef="Cust_Wait" />
    <bpmn:sequenceFlow id="Cf_3" sourceRef="Cust_Wait" targetRef="Cust_RecvFinal" />
    <bpmn:sequenceFlow id="Cf_4" sourceRef="Cust_Wait" targetRef="Cust_RecvTimeout" />
    <bpmn:sequenceFlow id="Cf_5" sourceRef="Cust_Wait" targetRef="Cust_RecvClarif" />
    <bpmn:sequenceFlow id="Cf_6" sourceRef="Cust_Wait" targetRef="Cust_RecvDup" />
    <bpmn:sequenceFlow id="Cf_7" sourceRef="Cust_Wait" targetRef="Cust_RecvHandoff" />
    <bpmn:sequenceFlow id="Cf_8" sourceRef="Cust_RecvFinal" targetRef="Cust_EndResolved" />
    <bpmn:sequenceFlow id="Cf_9" sourceRef="Cust_RecvTimeout" targetRef="Cust_EndTimeout" />
    <bpmn:sequenceFlow id="Cf_10" sourceRef="Cust_RecvClarif" targetRef="Cust_Provide" />
    <bpmn:sequenceFlow id="Cf_11" sourceRef="Cust_Provide" targetRef="Cust_Wait" />
    <bpmn:sequenceFlow id="Cf_12" sourceRef="Cust_RecvDup" targetRef="Cust_EndDup" />
    <bpmn:sequenceFlow id="Cf_13" sourceRef="Cust_RecvHandoff" targetRef="Cust_EndHandoff" />
  </bpmn:process>
  <bpmn:process id="Process_Nordcard" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Nordcard">
      <bpmn:lane id="Lane_Automation" name="Automation System (n8n + AI)">
        <bpmn:flowNodeRef>Start_RequestReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DetectDuplicate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Duplicate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_InfoComplete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ClassifyAI</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RetrieveData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Verified</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AssessRisk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Eligible</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GenerateDraft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendAuto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_MergeResponse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UpdateTicket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_TicketResolved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LinkTicket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyDuplicate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_DuplicateClosed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RequestInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WaitInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Revalidate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MarkTimedOut</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendTimeout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_TimedOut</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LogAIFailure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UpdateEscalated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendHandoff</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_SpecialistHandoff</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendHuman</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Timer_48h</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Err_Classify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Err_Generate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Err_Retrieve</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SupportAgent" name="Support Agent">
        <bpmn:flowNodeRef>Task_ManualClassify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RetrieveManual</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewCase</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_MergeReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Specialist</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_ApprovalRequired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_MergeApproved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Escalate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviseResponse</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SupportManager" name="Support Manager">
        <bpmn:flowNodeRef>Task_ReviewApprove</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Approved</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_RequestReceived" name="Request received">
      <bpmn:outgoing>Nf_main0</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_Request" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_Register" name="Register incoming ticket">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="register-ticket" />
      </bpmn:extensionElements>
      <bpmn:incoming>Nf_main0</bpmn:incoming>
      <bpmn:outgoing>Nf_main1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_DetectDuplicate" name="Detect duplicate ticket">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="detect-duplicate" />
      </bpmn:extensionElements>
      <bpmn:incoming>Nf_main1</bpmn:incoming>
      <bpmn:outgoing>Nf_main2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_Duplicate" name="Duplicate?">
      <bpmn:incoming>Nf_main2</bpmn:incoming>
      <bpmn:outgoing>Nf_dupNo</bpmn:outgoing>
      <bpmn:outgoing>Nf_dupYes</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Validate" name="Validate request information">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="validate-request" />
      </bpmn:extensionElements>
      <bpmn:incoming>Nf_dupNo</bpmn:incoming>
      <bpmn:outgoing>Nf_main3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_InfoComplete" name="Information complete?">
      <bpmn:incoming>Nf_main3</bpmn:incoming>
      <bpmn:incoming>Nf_loop</bpmn:incoming>
      <bpmn:outgoing>Nf_infoYes</bpmn:outgoing>
      <bpmn:outgoing>Nf_infoNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_ClassifyAI" name="Classify and prioritize with AI">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="ai-classify" />
      </bpmn:extensionElements>
      <bpmn:incoming>Nf_infoYes</bpmn:incoming>
      <bpmn:outgoing>Nf_main4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_RetrieveData" name="Retrieve verified order/policy data">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="retrieve-verified-data" />
      </bpmn:extensionElements>
      <bpmn:incoming>Nf_main4</bpmn:incoming>
      <bpmn:outgoing>Nf_main5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_Verified" name="Verified information available?">
      <bpmn:incoming>Nf_main5</bpmn:incoming>
      <bpmn:outgoing>Nf_verYes</bpmn:outgoing>
      <bpmn:outgoing>Nf_verNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_AssessRisk" name="Assess automation risk">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="assess-risk" />
      </bpmn:extensionElements>
      <bpmn:incoming>Nf_verYes</bpmn:incoming>
      <bpmn:outgoing>Nf_main6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_Eligible" name="Eligible for auto-response?">
      <bpmn:incoming>Nf_main6</bpmn:incoming>
      <bpmn:outgoing>Nf_eliYes</bpmn:outgoing>
      <bpmn:outgoing>Nf_eliNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_GenerateDraft" name="Generate AI response draft">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="ai-generate-draft" />
      </bpmn:extensionElements>
      <bpmn:incoming>Nf_eliYes</bpmn:incoming>
      <bpmn:outgoing>Nf_main7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Task_SendAuto" name="Send automated response">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-automated-response" />
      </bpmn:extensionElements>
      <bpmn:incoming>Nf_main7</bpmn:incoming>
      <bpmn:outgoing>Nf_main8</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="Gw_MergeResponse" name="Merge response paths (XOR)">
      <bpmn:incoming>Nf_main8</bpmn:incoming>
      <bpmn:incoming>Nf_humanMerge</bpmn:incoming>
      <bpmn:outgoing>Nf_main9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_UpdateTicket" name="Update ticket and audit log">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="update-ticket-audit" />
      </bpmn:extensionElements>
      <bpmn:incoming>Nf_main9</bpmn:incoming>
      <bpmn:outgoing>Nf_main10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_TicketResolved" name="Ticket resolved">
      <bpmn:incoming>Nf_main10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_LinkTicket" name="Link to existing ticket">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="link-ticket" />
      </bpmn:extensionElements>
      <bpmn:incoming>Nf_dupYes</bpmn:incoming>
      <bpmn:outgoing>Nf_link</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Task_NotifyDuplicate" name="Notify customer of duplicate">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notify-duplicate" />
      </bpmn:extensionElements>
      <bpmn:incoming>Nf_link</bpmn:incoming>
      <bpmn:outgoing>Nf_dupEnd</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_DuplicateClosed" name="Duplicate closed">
      <bpmn:incoming>Nf_dupEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="Task_RequestInfo" name="Request missing information">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="request-missing-info" />
      </bpmn:extensionElements>
      <bpmn:incoming>Nf_infoNo</bpmn:incoming>
      <bpmn:outgoing>Nf_req</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Task_WaitInfo" name="Wait for customer information">
      <bpmn:incoming>Nf_req</bpmn:incoming>
      <bpmn:outgoing>Nf_reply</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:serviceTask id="Task_Revalidate" name="Revalidate request information">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="revalidate-request" />
      </bpmn:extensionElements>
      <bpmn:incoming>Nf_reply</bpmn:incoming>
      <bpmn:outgoing>Nf_loop</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_MarkTimedOut" name="Mark ticket as timed out">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="mark-timed-out" />
      </bpmn:extensionElements>
      <bpmn:incoming>Nf_timeout</bpmn:incoming>
      <bpmn:outgoing>Nf_tm2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Task_SendTimeout" name="Send timeout notice">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-timeout-notice" />
      </bpmn:extensionElements>
      <bpmn:incoming>Nf_tm2</bpmn:incoming>
      <bpmn:outgoing>Nf_tm3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_TimedOut" name="Timed out">
      <bpmn:incoming>Nf_tm3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_LogAIFailure" name="Log automation failure">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="log-ai-failure" />
      </bpmn:extensionElements>
      <bpmn:incoming>Nf_errC</bpmn:incoming>
      <bpmn:incoming>Nf_errG</bpmn:incoming>
      <bpmn:incoming>Nf_errR</bpmn:incoming>
      <bpmn:outgoing>Nf_manual</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_UpdateEscalated" name="Update ticket status to escalated">
      <bpmn:incoming>Nf_escalate</bpmn:incoming>
      <bpmn:outgoing>Nf_escalateStatus</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Task_SendHandoff" name="Send handoff notice">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-handoff-notice" />
      </bpmn:extensionElements>
      <bpmn:incoming>Nf_escalateStatus</bpmn:incoming>
      <bpmn:outgoing>Nf_handoffEnd</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_SpecialistHandoff" name="Specialist case handed off">
      <bpmn:incoming>Nf_handoffEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="Task_SendHuman" name="Send human-approved response">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-human-response" />
      </bpmn:extensionElements>
      <bpmn:incoming>Nf_toHuman</bpmn:incoming>
      <bpmn:outgoing>Nf_humanMerge</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:boundaryEvent id="Timer_48h" name="48h elapsed" attachedToRef="Task_WaitInfo">
      <bpmn:outgoing>Nf_timeout</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_48h">
        <bpmn:timeDuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">PT48H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Err_Classify" name="AI error" attachedToRef="Task_ClassifyAI">
      <bpmn:outgoing>Nf_errC</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_Err_Classify" errorRef="Error_AI" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Err_Generate" name="AI error" attachedToRef="Task_GenerateDraft">
      <bpmn:outgoing>Nf_errG</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_Err_Generate" errorRef="Error_AI" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Err_Retrieve" name="Data retrieval failed" attachedToRef="Task_RetrieveData">
      <bpmn:outgoing>Nf_errR</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_Err_Retrieve" errorRef="Error_DataRetrieval" />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="Task_ManualClassify" name="Manual classification">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Nf_manual</bpmn:incoming>
      <bpmn:outgoing>Nf_m2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_RetrieveManual" name="Retrieve verified data manually">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Nf_m2</bpmn:incoming>
      <bpmn:outgoing>Nf_m3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ReviewCase" name="Review case and prepare response">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Nf_toReview</bpmn:incoming>
      <bpmn:outgoing>Nf_review</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_MergeReview" name="Merge human-review paths">
      <bpmn:incoming>Nf_verNo</bpmn:incoming>
      <bpmn:incoming>Nf_eliNo</bpmn:incoming>
      <bpmn:incoming>Nf_m3</bpmn:incoming>
      <bpmn:outgoing>Nf_toReview</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gw_Specialist" name="Specialist required?">
      <bpmn:incoming>Nf_review</bpmn:incoming>
      <bpmn:outgoing>Nf_specYes</bpmn:outgoing>
      <bpmn:outgoing>Nf_specNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gw_ApprovalRequired" name="Manager approval required?">
      <bpmn:incoming>Nf_specNo</bpmn:incoming>
      <bpmn:outgoing>Nf_apprYes</bpmn:outgoing>
      <bpmn:outgoing>Nf_apprNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gw_MergeApproved" name="Merge approved paths (XOR)">
      <bpmn:incoming>Nf_apprNo</bpmn:incoming>
      <bpmn:incoming>Nf_approvedYes</bpmn:incoming>
      <bpmn:outgoing>Nf_toHuman</bpmn:outgoing>
    </bpmn:exclusiveGateway>

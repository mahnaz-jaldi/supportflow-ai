    {
      "parameters": {
        "jsCode": "\nconst items = $input.all();\n\nreturn items.map(item => {\n  const data = item.json.output ?? {};\n\n  const validCategories = [\n    'delivery', 'returns', 'cancellation', 'other'\n  ];\n\n  const validPriorities = ['low', 'medium', 'high'];\n  const validRisks = ['low', 'medium', 'high'];\n\n  const category = data.category;\n  const priority = data.priority;\n  const risk = data.risk_level;\n  const confidence = data.ai_confidence;\n\n  const valid =\n    validCategories.includes(category) &&\n    validPriorities.includes(priority) &&\n    validRisks.includes(risk) &&\n    typeof confidence === 'number' &&\n    Number.isFinite(confidence) &&\n    confidence >= 0 &&\n    confidence <= 1;\n\n  const sensitiveCategory =\n    category === 'returns' ||\n    category === 'cancellation';\n\n  const requiresReview =\n    !valid ||\n    sensitiveCategory ||\n    risk !== 'low' ||\n    confidence < 0.8 ||\n    category === 'other';\n\n  const reasons = [];\n\n  if (!valid) reasons.push('invalid_ai_output');\n  if (sensitiveCategory) reasons.push('sensitive_category');\n  if (valid && risk !== 'low') reasons.push('non_low_risk');\n  if (valid && confidence < 0.8) reasons.push('low_confidence');\n  if (category === 'other') reasons.push('unknown_category');\n\n  return {\n    json: {\n      ...item.json,\n      classification_valid: valid,\n      requires_human_review: requiresReview,\n      review_reasons: reasons\n    }\n  };\n});\n"
      },
